# ============================================
# Sentifargo Production Dockerfile
# Multi-stage build for optimized image size
# ============================================

# Stage 0: Frontend Builder
FROM node:20-alpine as frontend-builder

WORKDIR /app/ui-web/frontend

# Install frontend deps
COPY ui-web/frontend/package*.json ./
RUN npm ci

# Build React UI
COPY ui-web/frontend/ ./
RUN npm run build

# Stage 1: Builder
FROM python:3.11-slim as builder

WORKDIR /build

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Create virtual environment
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Install Python dependencies
COPY requirements.txt requirements-optional.txt ./
RUN pip install --no-cache-dir --upgrade pip wheel setuptools && \
    pip install --no-cache-dir -r requirements.txt

# ============================================
# Stage 2: Production Runtime
# ============================================
FROM python:3.11-slim as production

# Security: Create non-root user
RUN groupadd -r Sentifargo && useradd -r -g Sentifargo Sentifargo

WORKDIR /app

# Install runtime dependencies only
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    libsndfile1 \
    ffmpeg \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Copy virtual environment from builder
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy application code
COPY --chown=Sentifargo:Sentifargo . .

# Copy built frontend assets
COPY --from=frontend-builder /app/ui-web/frontend/dist /app/ui-web/frontend/dist

# Create necessary directories with proper permissions
RUN mkdir -p /app/logs /app/data/monitoring /app/artifacts \
    && chown -R Sentifargo:Sentifargo /app

# Environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app \
    APP_ENV=production \
    LOG_LEVEL=INFO \
    PORT=8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:${PORT}/health || exit 1

# Expose port
EXPOSE ${PORT}

# Switch to non-root user
USER Sentifargo

# Production command with Gunicorn
CMD ["gunicorn", "app.main:app", \
     "--workers", "4", \
     "--worker-class", "uvicorn.workers.UvicornWorker", \
     "--bind", "0.0.0.0:8000", \
     "--timeout", "120", \
     "--keep-alive", "5", \
     "--access-logfile", "-", \
     "--error-logfile", "-", \
     "--capture-output", \
     "--enable-stdio-inheritance"]

# ============================================
# Stage 3: Development (optional)
# ============================================
FROM production as development

USER root

# Install dev dependencies
RUN pip install --no-cache-dir \
    pytest \
    pytest-cov \
    pytest-asyncio \
    httpx \
    black \
    ruff \
    mypy

# Development command with hot reload
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
