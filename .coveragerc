[run]
source = 
    app/
    src/
branch = true
omit =
    */tests/*
    */__pycache__/*
    */migrations/*
    */notebooks/*
    */experiments/*
    */venv/*
    */.venv/*
    */site-packages/*
    */node_modules/*
    */build/*
    */dist/*
    */.next/*
    */data/*
    */models/*
    */artifacts/*
    */reports/*

# Per-module thresholds are enforced via scripts/quality/quality_thresholds.py in CI.

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    if typing.TYPE_CHECKING:
    @abstractmethod
    @abc.abstractmethod

show_missing = true
precision = 2

[html]
directory = reports/coverage_html

[xml]
output = reports/coverage.xml

[json]
output = reports/coverage.json
