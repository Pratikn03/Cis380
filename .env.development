# ============================================
# Sentifargo — Development environment
# ============================================
# Loaded BEFORE .env when APP_ENV=development is set in the process env
# (see app/core/config.py). Values here win over .env.
#
# This file is committed; never put real secrets here. For machine-local
# overrides, use .env.local (gitignored).

APP_ENV=development
APP_NAME=Sentifargo
APP_VERSION=1.0.0-dev
DEBUG=true
LOG_LEVEL=DEBUG

# ---- Server ----
API_HOST=127.0.0.1
API_PORT=8000
WORKERS=1
TIMEOUT=120
MAX_REQUEST_SIZE=50MB

# ---- Security (dev-only, throwaway values) ----
SECRET_KEY=dev-secret-not-for-production-change-me-aaaaaaaaaaaaaaaaaaaaaaaaaaaa
AUTH_TOKEN=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
BOOTSTRAP_TOKEN=dev-bootstrap-token

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000
ALLOWED_HOSTS=*
FORCE_HTTPS=false
# AUTH_BYPASS=true is dev-only (refused in production by app/core/auth._auth_bypass_enabled)
AUTH_BYPASS=true

RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW=60

# ---- Database (matches docker-compose.dev.yml) ----
POSTGRES_DB=sentifargo
POSTGRES_USER=sentifargo
POSTGRES_PASSWORD=sentifargo
DATABASE_URL=postgresql+psycopg2://sentifargo:sentifargo@localhost:5432/sentifargo

# ---- Redis (matches docker-compose.dev.yml) ----
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
CACHE_TTL=300

# ---- LLM providers (set in .env.local for real keys) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2000
LLM_MODE=offline

# ---- Multi-agent (Claude) ----
AGENT_PLANNER_MODEL=claude-opus-4-7
AGENT_TRIAGE_MODEL=claude-haiku-4-5
AGENT_SYNTHESIS_MODEL=claude-haiku-4-5
AGENT_THINKING_BUDGET=4000
AGENT_MAX_TOOL_CALLS=8
AGENT_MAX_TOKENS_PER_TURN=30000
AGENT_CACHE_TTL_SECONDS=300
AGENT_CONFIDENCE_ESCALATION_THRESHOLD=0.6

# ---- ML model paths ----
MODELS_DIR=./models
ARTIFACTS_DIR=./artifacts
VISION_MODEL=yolov8n
VISION_CONFIDENCE_THRESHOLD=0.5
VOICE_EMOTION_MODEL=default
WHISPER_MODEL=base
PIPER_BIN=
PIPER_MODEL=
PIPER_CONFIG=

# ---- RAG ----
RAG_ENABLED=true
RAG_EMBEDDINGS_DIR=./data/embeddings
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=5

DSA_DOCS_DIR=./data/dsa_docs
DSA_EMBED_DIR=./data/dsa_embeddings
DSA_CACHE_DIR=./data/processed/cache/dsa
DSA_TOPK_DENSE=12
DSA_TOPK_BM25=12
DSA_TOPK_MERGED=24
DSA_TOPK_FINAL=6
DSA_AUTO_INGEST=true
DSA_ONLINE_MODE=false
DSA_ONLINE_FALLBACK_MIN_SCORE=0.2

# ---- Observability ----
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
SENTRY_DSN=

# ---- Feature flags ----
FEATURE_FRAUD_DETECTION=true
FEATURE_CYBER_ANALYSIS=true
FEATURE_BEHAVIOR_PROFILING=true
FEATURE_VISION_ANALYSIS=true
FEATURE_VOICE_EMOTION=true
FEATURE_RECOMMENDATIONS=true
FEATURE_RAG_CHAT=true

# ---- Dev convenience ----
COPYFILE_DISABLE=1
KMP_DUPLICATE_LIB_OK=True
TOKENIZERS_PARALLELISM=false
