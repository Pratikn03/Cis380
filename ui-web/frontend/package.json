{
  "name": "sentifargo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:compat": "VITE_BASE_PATH=/ui/ tsc -b && VITE_BASE_PATH=/ui/ vite build",
    "build:local": "VITE_BASE_PATH=/ui/ tsc -b && VITE_BASE_PATH=/ui/ vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:compat": "vitest",
    "test:compat:ci": "vitest run",
    "test:compat:stable": "vitest run",
    "test:compat:coverage": "vitest run --coverage",
    "test:compat:coverage:stable": "vitest run --coverage",
    "test:ci": "vitest run",
    "test:ci:stable": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:stable": "vitest run --coverage"
  },
  "dependencies": {
    "axios": "^1.7.5",
    "clsx": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.4.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "^2.1.8",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "jsdom": "^26.0.0",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vitest": "^2.1.8"
  }
}
