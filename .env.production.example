# ============================================
# Sentifargo Environment Configuration
# Copy this to .env and customize
# ============================================

# ==========================================
# Application Settings
# ==========================================
APP_ENV=production
APP_NAME=Sentifargo
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# ==========================================
# Server Configuration
# ==========================================
API_HOST=0.0.0.0
API_PORT=8000
# UI_PORT is unused for React UI (served by the API container)
# UI_PORT=8501
WORKERS=4
TIMEOUT=120
MAX_REQUEST_SIZE=50MB

# ==========================================
# Security
# ==========================================
# Generate with: openssl rand -hex 32
SECRET_KEY=your-secret-key-here-change-in-production
# Optional legacy token (leave empty for JWT-only auth)
AUTH_TOKEN=

# Admin bootstrap (recommended for first run)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
# Optional: protect /api/v1/admin/bootstrap with a one-time token
BOOTSTRAP_TOKEN=change-this-bootstrap-token

# CORS settings (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8501,https://yourdomain.com
ALLOWED_HOSTS=yourdomain.com
FORCE_HTTPS=true

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ==========================================
# Database
# ==========================================
POSTGRES_DB=sentifargo
POSTGRES_USER=sentifargo
POSTGRES_PASSWORD=change-this-db-password
DATABASE_URL=postgresql+psycopg2://sentifargo:change-this-db-password@postgres:5432/sentifargo
# For SQLite (not recommended for production):
# DATABASE_URL=sqlite:///./data/Sentifargo.db

# ==========================================
# Redis Cache
# ==========================================
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
CACHE_TTL=3600

# ==========================================
# External APIs
# ==========================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2000

# HuggingFace
HUGGINGFACE_TOKEN=

# ==========================================
# ML Models
# ==========================================
MODELS_DIR=./models
ARTIFACTS_DIR=./artifacts

# Vision models
VISION_MODEL=yolov8n
VISION_CONFIDENCE_THRESHOLD=0.5
YOLOV3_CFG=artifacts/vision/yolov3/yolov3.cfg
YOLOV3_WEIGHTS=artifacts/vision/yolov3/yolov3.weights
YOLOV3_NAMES=artifacts/vision/yolov3/coco.names
YOLOV3_INPUT_SIZE=416
YOLOV3_CONFIDENCE=0.5
YOLOV3_NMS=0.4
YOLOV3_MAX_DETECTIONS=50
YOLOV3_BACKEND=opencv
YOLOV3_TARGET=cpu
YOLOV3_ALLOWED_CLASSES=
YOLOV3_ALLOWED_IDS=

# Voice models
VOICE_EMOTION_MODEL=default
WHISPER_MODEL=base
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_LANGUAGE=en
STT_STREAM_MIN_BYTES=48000
PIPER_BIN=
PIPER_MODEL=
PIPER_CONFIG=

# ==========================================
# RAG Configuration
# ==========================================
RAG_ENABLED=true
RAG_EMBEDDINGS_DIR=./data/embeddings
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=5

# DSA RAG (offline-first)
DSA_DOCS_DIR=./data/dsa_docs
DSA_EMBED_DIR=./data/dsa_embeddings
DSA_CACHE_DIR=./data/processed/cache/dsa
DSA_TOPK_DENSE=12
DSA_TOPK_BM25=12
DSA_TOPK_MERGED=24
DSA_TOPK_FINAL=6
DSA_AUTO_INGEST=true
DSA_ONLINE_MODE=false
DSA_OPENAI_MODEL=gpt-4.1-nano
DSA_ONLINE_FALLBACK_MIN_SCORE=0.2

# ==========================================
# Monitoring & Observability
# ==========================================
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# Sentry error tracking (optional)
SENTRY_DSN=

# ==========================================
# Docker / Production
# ==========================================
COMPOSE_PROJECT_NAME=Sentifargo
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# SSL certificates
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# ==========================================
# Streamlit UI
# ==========================================
Sentifargo_BACKEND=http://localhost:8000
STREAMLIT_THEME=dark
STREAMLIT_PRIMARY_COLOR=#3b82f6

# ==========================================
# Feature Flags
# ==========================================
FEATURE_FRAUD_DETECTION=true
FEATURE_CYBER_ANALYSIS=true
FEATURE_BEHAVIOR_PROFILING=true
FEATURE_VISION_ANALYSIS=true
FEATURE_VOICE_EMOTION=true
FEATURE_RECOMMENDATIONS=true
FEATURE_RAG_CHAT=true
