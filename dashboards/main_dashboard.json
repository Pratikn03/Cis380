{
    "__inputs": [],
    "__requires": [
        {
            "type": "grafana",
            "id": "grafana",
            "name": "Grafana",
            "version": "7.5.0"
        },
        {
            "type": "prometheus",
            "id": "prometheus",
            "name": "Prometheus",
            "version": "2.0.0"
        }
    ],
    "annotations": {
        "list": [
            {
                "builtIn": 1,
                "datasource": "-- Grafana --",
                "enable": true,
                "hide": true,
                "iconColor": "rgba(0, 211, 255, 1)",
                "name": "Annotations & Alerts",
                "type": "dashboard"
            }
        ]
    },
    "editable": true,
    "gnetId": null,
    "graphTooltip": 0,
    "id": null,
    "links": [],
    "panels": [
        {
            "title": "System Overview",
            "type": "row",
            "collapsed": false,
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 0
            }
        },
        {
            "title": "CPU Usage",
            "type": "graph",
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "Sentifargo_cpu_usage_percent",
                    "legendFormat": "CPU Usage (%)"
                }
            ],
            "gridPos": {
                "h": 8,
                "w": 8,
                "x": 0,
                "y": 1
            },
            "yaxis": {
                "format": "percent"
            }
        },
        {
            "title": "Memory Usage",
            "type": "graph",
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "Sentifargo_memory_usage_bytes",
                    "legendFormat": "Memory Usage"
                }
            ],
            "gridPos": {
                "h": 8,
                "w": 8,
                "x": 8,
                "y": 1
            },
            "yaxis": {
                "format": "bytes"
            }
        },
        {
            "title": "Active Connections",
            "type": "graph",
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "Sentifargo_active_connections",
                    "legendFormat": "Active Connections"
                }
            ],
            "gridPos": {
                "h": 8,
                "w": 8,
                "x": 16,
                "y": 1
            }
        },
        {
            "title": "HTTP Requests",
            "type": "row",
            "collapsed": false,
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 9
            }
        },
        {
            "title": "Request Rate",
            "type": "graph",
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "sum(rate(Sentifargo_requests_total[5m])) by (endpoint)",
                    "legendFormat": "{{endpoint}}"
                }
            ],
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 10
            },
            "description": "Total requests per second"
        },
        {
            "title": "Request Latency (95th percentile)",
            "type": "graph",
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "histogram_quantile(0.95, sum(rate(Sentifargo_request_duration_seconds_bucket[5m])) by (le, endpoint))",
                    "legendFormat": "{{endpoint}}"
                }
            ],
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 10
            },
            "yaxis": {
                "format": "s"
            }
        },
        {
            "title": "Model Performance",
            "type": "row",
            "collapsed": false,
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 18
            }
        },
        {
            "title": "Model Inference Rate",
            "type": "graph",
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "sum(rate(Sentifargo_model_inference_total[5m])) by (model_type)",
                    "legendFormat": "{{model_type}}"
                }
            ],
            "gridPos": {
                "h": 8,
                "w": 8,
                "x": 0,
                "y": 19
            },
            "description": "Inferences per second by model type"
        },
        {
            "title": "Model Inference Latency (95th percentile)",
            "type": "graph",
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "histogram_quantile(0.95, sum(rate(Sentifargo_model_inference_seconds_bucket[5m])) by (le, model_type))",
                    "legendFormat": "{{model_type}}"
                }
            ],
            "gridPos": {
                "h": 8,
                "w": 8,
                "x": 8,
                "y": 19
            },
            "yaxis": {
                "format": "s"
            }
        },
        {
            "title": "Model Errors",
            "type": "graph",
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "sum(rate(Sentifargo_model_errors_total[5m])) by (model_type)",
                    "legendFormat": "{{model_type}}"
                }
            ],
            "gridPos": {
                "h": 8,
                "w": 8,
                "x": 16,
                "y": 19
            }
        },
        {
            "title": "Component Health",
            "type": "row",
            "collapsed": false,
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 27
            }
        },
        {
            "title": "Health Check Status",
            "type": "stat",
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "Sentifargo_health_check_status",
                    "legendFormat": "{{component}}"
                }
            ],
            "gridPos": {
                "h": 8,
                "w": 24,
                "x": 0,
                "y": 28
            },
            "colorMode": "value",
            "graphMode": "area",
            "reduceOptions": {
                "values": false,
                "calcs": [
                    "lastNotNull"
                ],
                "fields": ""
            },
            "thresholds": [
                {
                    "value": 0,
                    "color": "red"
                },
                {
                    "value": 0.5,
                    "color": "orange"
                },
                {
                    "value": 1,
                    "color": "green"
                }
            ],
            "mappings": [
                {
                    "type": "value",
                    "value": "1",
                    "text": "Healthy"
                },
                {
                    "type": "value",
                    "value": "0.5",
                    "text": "Degraded"
                },
                {
                    "type": "value",
                    "value": "0",
                    "text": "Unhealthy"
                }
            ]
        }
    ],
    "schemaVersion": 27,
    "style": "dark",
    "tags": [],
    "templating": {
        "list": []
    },
    "time": {
        "from": "now-6h",
        "to": "now"
    },
    "timepicker": {},
    "timezone": "browser",
    "title": "Sentifargo Overview",
    "version": 1
}